# Lantern Payment Service — Environment Variables (names only, no real values)
#
# Copy to .env and fill in real values locally. Never commit a filled-in
# .env file. This example file itself contains no secrets and is safe
# to commit.

# Required. Public EVM address that receives settled payments.
# Current operator-designated value (public, not secret):
# 0xD062a97d1Bc9D7CE42B2bD1E4BD7f9d3aa4E2683
LANTERN_PAYMENT_RECIPIENT_EVM=

# Optional. Price per /v1/reconcile call, e.g. "$0.001". Defaults to
# "$0.001" if unset.
LANTERN_RECONCILIATION_PRICE=

# Coinbase Developer Platform API credentials. SECRET. Required for the
# real production x402 facilitator path. Never commit real values here.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Optional. Only used if CDP_API_KEY_ID/CDP_API_KEY_SECRET are absent.
# A caller-supplied alternate x402 facilitator base URL.
LANTERN_FACILITATOR_URL=
